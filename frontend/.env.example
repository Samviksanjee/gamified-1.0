# Copy to .env.local (never commit real .env files). Only non-secret values: every VITE_* variable is public in the browser bundle.

# Production (set this in Vercel > Project > Settings > Environment Variables).
# Prefix verified against https://api.avinyaa.tech/openapi.json: all application routes are under /api/v1.
VITE_API_BASE_URL=https://api.avinyaa.tech/api/v1

# Optional. Origin serving backend files (/uploads, /media). Defaults to the origin of VITE_API_BASE_URL.
# VITE_ASSET_BASE_URL=https://api.avinyaa.tech

# Optional. Request timeout in milliseconds (default 60000; uploads and AI generation use at least 300000).
# VITE_API_TIMEOUT_MS=60000
